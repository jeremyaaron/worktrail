{
  "name": "worktrail",
  "version": "0.3.1",
  "private": true,
  "description": "Worktrail project management reference app.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:setup": "node scripts/verify-local-setup.mjs",
    "verify:upgrade": "node scripts/verify-upgrade.mjs",
    "check:site": "node scripts/check-site.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "test:verification": "node --test scripts/verification/*.test.mjs",
    "test:verification:integration": "node --test scripts/verification/lifecycle.check.mjs",
    "test:verification:web-lifecycle": "node --test scripts/verification/web-lifecycle.check.mjs",
    "test:verification:upgrade-lifecycle": "node --test scripts/verification/upgrade.check.mjs",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @worktrail/api",
    "dev:web": "npm run start --workspace @worktrail/web",
    "build": "npm run build --workspace @worktrail/contracts && npm run build --workspace @worktrail/api && npm run build --workspace @worktrail/web",
    "build:api": "npm run build --workspace @worktrail/api",
    "build:web": "npm run build --workspace @worktrail/web",
    "build:contracts": "npm run build --workspace @worktrail/contracts",
    "check": "npm run typecheck && npm test",
    "preview": "npm run build && npm run start:prod",
    "start:prod": "NODE_ENV=production npm run start --workspace @worktrail/api",
    "typecheck": "npm run typecheck:verification && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/verify.mjs --mode=e2e",
    "test:editor": "node scripts/verify.mjs --mode=editor",
    "test:e2e:ui": "node scripts/verify.mjs --mode=e2e --ui",
    "test:preview": "node scripts/verify.mjs --mode=preview",
    "test:site": "node scripts/verify.mjs --mode=site",
    "lint": "npm run lint:verification && npm run lint --workspaces --if-present",
    "lint:verification": "eslint apps/api/tests apps/api/vitest.config.ts e2e playwright*.config.ts scripts apps/web/browser-tests/authored-content-editor/*.ts --max-warnings=0",
    "typecheck:verification": "tsc -p tsconfig.verification.json --noEmit && npm run typecheck --workspace @worktrail/api",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "npm run db:generate --workspace @worktrail/api",
    "db:migrate": "npm run db:migrate --workspace @worktrail/api",
    "db:reset": "npm run db:reset --workspace @worktrail/api",
    "db:seed": "npm run db:seed --workspace @worktrail/api",
    "db:performance-evidence": "npm run db:performance-evidence --workspace @worktrail/api",
    "db:quick-find-performance-evidence": "npm run db:quick-find-performance-evidence --workspace @worktrail/api",
    "db:cycle-diagnostics": "npm run db:cycle-diagnostics --workspace @worktrail/api --",
    "storage:reset": "npm run storage:reset --workspace @worktrail/api",
    "test:web": "node scripts/test-web.mjs"
  },
  "devDependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "angular-eslint": "21.4.0",
    "chokidar": "5.0.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.62.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  }
}
